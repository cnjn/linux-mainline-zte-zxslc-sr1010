			compatible = "zte,zx279133-rgmii";
			reg = <0x00 0x15900000 0x00 0x100000>;
			status = "disabled";
		};

		pon_serdes@16000000 {
			compatible = "zte,zx279133-pon_serdes";
			reg = <0x00 0x16000000 0x00 0x10000>;
			status = "disabled";
		};

		pon_serdes_pll@16010000 {
			compatible = "zte,zx279133-pon_serdes_pll";
			reg = <0x00 0x16010000 0x00 0x10000>;
			status = "disabled";
		};

		uni_serdes@16100000 {
			compatible = "zte,zx279133-uni_serdes";
			reg = <0x00 0x16100000 0x00 0x100000>;
			status = "disabled";
		};

		pcu@10e30000 {
			compatible = "zte,zx279133-pcu";
			reg = <0x00 0x10e30000 0x00 0x10000>;
			status = "disabled";
		};

		gephy_apb@15400000 {
			compatible = "zte,zx279133-gephy-apb";
			reg = <0x00 0x15400000 0x00 0x500000>;
			status = "disabled";
		};

		ipsec@12000000 {
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			compatible = "zte,zx279133-ipsec";
			reg = <0x00 0x12000000 0x00 0x1000000 0x00 0x13000000 0x00 0x1000000>;
			interrupts = <0x00 0xae 0x04 0x00 0xaf 0x04 0x00 0xb0 0x04 0x00 0xb1 0x04 0x00 0xb2 0x04 0x00 0xb3 0x04 0x00 0xb4 0x04 0x00 0xb5 0x04 0x00 0xb6 0x04 0x00 0xb7 0x04 0x00 0xb8 0x04>;
			status = "disabled";
		};

		idm@19280000 {
			compatible = "zte,zx279133-idm-intr";
			interrupts = <0x00 0x01 0x04 0x00 0x02 0x04 0x00 0x03 0x04 0x00 0x04 0x04>;
			status = "disabled";
		};

		xpcs@1a000000 {
			compatible = "zte,zx279133-xmac0-pcs";
			reg = <0x00 0x1a000000 0x00 0x2000000>;
			status = "disabled";
		};

		se@18040000 {
			compatible = "zte,zx279133-se-ddr";
			status = "okay";

			se_ddr_hash {
			};

			se_ddr_ddr {
			};
		};

		woe@19240000 {
			compatible = "zte,zx279133-woe-ddr";
			interrupts = <0x00 0xac 0x04 0x00 0xad 0x04>;
			status = "okay";
		};

		bmu@1903c000 {
			compatible = "zte,zx279133-bmu-ddr";
			status = "okay";

			bmu_ddr_mem {
			};
		};
	};

	chosen {
		bootargs = "console=ttyAMA0,115200n8 rdinit=/sbin/init mem=512M ";
		versioninfo = [00];
		stdout-path = "/soc/serial@10d0d000";
	};

	part@256 {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		phandle = <0x2b>;

		partition@whole {
			label = "whole flash";
			reg = <0x00 0x10000000>;
		};

		partition@bootloader {
			label = "bootloader";
			reg = <0x00 0x100000>;
		};

		partition@tag {
			label = "tags";
			reg = <0x100000 0x100000>;
		};

		partition@usercfg {
			label = "usercfg";
			reg = <0x200000 0x200000>;
		};

		partition@defcfg {
			label = "defcfg";
			reg = <0x400000 0x200000>;
		};

		partition@kern0 {
			label = "kernel1";
			reg = <0x600000 0x2900000>;
		};

		partition@kern1 {
			label = "kernel2";
			reg = <0x2f00000 0x2900000>;
		};

		partition@rootfs0 {
			label = "rootfs1";
			reg = <0x600000 0x2900000>;
		};

		partition@rootfs1 {
			label = "rootfs2";
			reg = <0x2f00000 0x2900000>;
		};

		partition@Plugin {
			label = "Plugin";
			reg = <0x5800000 0x2800000>;
		};
	};

	part@128 {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
