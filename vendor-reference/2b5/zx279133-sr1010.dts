		};

		partition@usercfg {
			label = "usercfg";
			reg = <0x200000 0x200000>;
		};

		partition@defcfg {
			label = "defcfg";
			reg = <0x400000 0x200000>;
		};

		partition@kern0 {
			label = "kernel1";
			reg = <0x600000 0x2900000>;
		};

		partition@kern1 {
			label = "kernel2";
			reg = <0x2f00000 0x2900000>;
		};

		partition@rootfs0 {
			label = "rootfs1";
			reg = <0x600000 0x2900000>;
		};

		partition@rootfs1 {
			label = "rootfs2";
			reg = <0x2f00000 0x2900000>;
		};

		partition@Plugin {
			label = "Plugin";
			reg = <0x5800000 0x2800000>;
