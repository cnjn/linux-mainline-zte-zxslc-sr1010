/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	model = "ZTE 133";
	compatible = "zte,133";

	top_fixed {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		osc25m {
			compatible = "zxic,zx-fixed-rate", "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x17d7840>;
			clock-output-names = "osc25m";
			phandle = <0x02>;
		};

		osc50m_clk {
			compatible = "zxic,zx-fixed-rate", "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x2faf080>;
			clock-output-names = "osc50m";
		};
	};

	fixed_div {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		sd_wclk_div {
			compatible = "zxic,zx-fixed-factor";
			clock-div = <0x04>;
			clock-mult = <0x01>;
			zx-clock,set-rate-parent = <0x01>;
			zx-clock,parent-names = "sd_wclk_mux";
			clock-output-names = "sd_wclk_div";
		};

		nand_wclk {
			compatible = "zxic,zx-fixed-factor";
			#clock-cells = <0x00>;
			clock-div = <0x04>;
			clock-mult = <0x01>;
			zx-clock,set-rate-parent = <0x01>;
			zx-clock,parent-names = "nand_xclk";
			clock-output-names = "nand_wclk";
			phandle = <0x2a>;
		};
	};

	top_pll {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		pll_2000m_clk {
			compatible = "zxic,zx-pll";
			#clock-cells = <0x01>;
			reg = <0x00 0x10e10080 0x00 0x10>;
			pll-en-bit = <0x3c 0x01>;
			clocks = <0x02>;
			clock-frequency = <0x77359400>;
			zx-clock,set-rate-parent = <0x01>;
			zx-pll,factor = <0x02>;
			zx-pll,freq-table = <0x6b49d200 0x20104821 0x15000000 0x77359400 0x20105021 0x15000000 0x83215600 0x20105821 0x15000000 0x8f0d1800 0x20106021 0x15000000 0x9af8da00 0x20106821 0x15000000 0xa6e49c00 0x20107021 0x15000000>;
			clock-output-names = "clk1000m_cpu";
		};

		pll_lsp_2000m_clk {
			compatible = "zxic,zx-pll";
			zx-pll,fixed;
			#clock-cells = <0x01>;
			clocks = <0x02>;
			clock-frequency = <0x77359400>;
			zx-pll,factor = <0x02 0x04 0x08 0x10 0x20 0x05 0x0a 0x14 0x28 0x7d0>;
			clock-output-names = "clk1000m", "clk500m", "clk250m", "clk125m", "clk62m5", "clk400m", "clk200m", "clk100m", "clk50m", "clk1m";
		};

		pll_1376m_clk {
			compatible = "zxic,zx-pll";
			zx-pll,fixed;
			#clock-cells = <0x01>;
			clocks = <0x02>;
			clock-frequency = "R\b", "";
			zx-pll,factor = <0x01 0x02 0x04 0x08 0x1c 0xa410>;
			clock-output-names = "clk1376m", "clk688m", "clk344m", "clk172m", "clk49m152", "clk32k768";
		};

		pll_fpp_2500m_clk {
			compatible = "zxic,zx-pll";
			zx-pll,fixed;
			#clock-cells = <0x01>;
			clocks = <0x02>;
			clock-frequency = <0x9502f900>;
			zx-pll,factor = <0x01 0x14 0x64>;
			clock-output-names = "clk2500m", "clk_pon_125m", "sysnce_out_clk";
		};
	};

	top_mux {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		mux@0 {
			compatible = "zxic,zx-mux";
			reg = <0x00 0x10e10000 0x00 0x04>;
			#clock-cells = <0x01>;
			zx-clock,bit-shift = <0x00>;
			zx-clock,bit-width = <0x02>;
			zx-clock,parent-names-0 = "osc25m", "clk100m", "clk200m", "clk250m";
			clock-output-names = "sys_aclk";
		};

		mux@1 {
			compatible = "zxic,zx-mux";
			reg = <0x00 0x10e10004 0x00 0x04>;
			#clock-cells = <0x01>;
			zx-clock,set-rate-parent = <0x01 0x00>;
			zx-clock,bit-shift = <0x00 0x04>;
			zx-clock,bit-width = <0x03 0x03>;
			zx-clock,parent-names-0 = "osc25m", "clk100m", "clk250m", "clk400m", "clk500m", "clk688m", "clk416m", "clk1000m_cpu";
			zx-clock,parent-names-1 = "osc25m", "clk100m", "clk200m", "clk250m", "clk344m", "clk400m", "clk688m", "clk500m";
			clock-output-names = "a53_mclk", "cci_aclk";
			phandle = <0x07>;
		};

		mux@2 {
			compatible = "zxic,zx-mux";
			reg = <0x00 0x10e10008 0x00 0x04>;
			#clock-cells = <0x01>;
			zx-clock,bit-shift = <0x00 0x04 0x08 0x0c>;
			zx-clock,bit-width = <0x01 0x01 0x03 0x02>;
			zx-clock,parent-names-0 = "osc25m", "clk100m";
			zx-clock,parent-names-1 = "clk100m", "clk200m";
			zx-clock,parent-names-2 = "osc25m", "clk50m", "clk100m", "clk125m", "clk142m857", "clk156m25", "clk172m", "clk200m";
			zx-clock,parent-names-3 = "osc25m", "clk125m", "clk172m", "clk200m";
			clock-output-names = "nand_wclk_mux", "sd_wclk_mux", "spifc_wclk_mux", "sec_wclk_mux";
		};

		mux@3 {
			compatible = "zxic,zx-mux";
			reg = <0x00 0x10e1000c 0x00 0x04>;
			#clock-cells = <0x01>;
			zx-clock,bit-shift = <0x00 0x04 0x10 0x14 0x18>;
			zx-clock,bit-width = <0x03 0x03 0x01 0x03 0x03>;
			zx-clock,parent-names-0 = "osc25m", "clk100m", "clk125m", "clk200m", "clk250m", "clk344m", "clk400m", "clk500m";
			zx-clock,parent-names-1 = "osc25m", "clk100m", "clk250m", "clk400m", "clk500m", "clk1000m", "clk688m", "clk1376m_div";
			zx-clock,parent-names-2 = "clk100m", "clk250m";
			zx-clock,parent-names-3 = "osc25m", "clk50m", "clk125m", "clk172m", "clk250m", "clk344m", "clk500m", "clk400m";
			zx-clock,parent-names-4 = "osc25m", "clk100m", "clk200m", "clk344m", "clk400m", "clk500m", "clk416m", "clk_pon_125m";
			clock-output-names = "pon_tm_clk_mux", "pon_core_clk_mux", "pon_rgmii_clk_mux", "pon_woe0_wclk_mux", "pon_nppt_wclk_mux";
		};

		mux@4 {
			compatible = "zxic,zx-mux";
			reg = <0x00 0x10e10010 0x00 0x04>;
			#clock-cells = <0x01>;
			zx-clock,bit-shift = <0x00>;
			zx-clock,bit-width = <0x01>;
			zx-clock,parent-names-0 = "osc25m", "clk40m";
			clock-output-names = "pcie_25m_mux";
		};
	};

	top_divider {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		top_clk_div0 {
			compatible = "zxic,zx-div";
			reg = <0x00 0x10e10058 0x00 0x04>;
			zx-clock,bit-shift = <0x00 0x08 0x0d 0x13>;
			zx-clock,bit-width = <0x06 0x05 0x06 0x06>;
			zx-clock,even-divider = <0x00 0x00 0x01 0x01>;
			zx-clock,parent-names = "clk50m", "clk400m", "clk1376m", "clk2500m";
			clock-output-names = "clk1m22", "clk40m", "clk1376m_div", "clk416m";
		};

		top_clk_div1 {
			compatible = "zxic,zx-div";
			reg = <0x00 0x10e1005c 0x00 0x04>;
			zx-clock,bit-shift = <0x00 0x04>;
			zx-clock,bit-width = <0x02 0x02>;
			zx-clock,even-divider = <0x01 0x01>;
			zx-clock,parent-names = "sys_aclk", "sys_aclk";
			clock-output-names = "sys_hclk", "sys_pclk";
		};
	};

	top_gate {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		top_clk_gate0 {
			compatible = "zxic,zx-gate";
			reg = <0x00 0x10e10030 0x00 0x04>;
			#clock-cells = <0x01>;
			zx-clock,ignore-unused = <0x01 0x01 0x01 0x01 0x01>;
			zx-clock,set-rate-parent = <0x00 0x00 0x00 0x00 0x00>;
			clock-indices = <0x04 0x05 0x0a 0x0b 0x0c>;
			zx-clock,bit-shift = <0x04 0x05 0x0a 0x0b 0x0c>;
			zx-clock,parent-names = "sys_aclk", "sys_pclk", "sys_pclk", "osc25m", "clk172m";
			clock-output-names = "dma_aclk", "dma_pclk", "pcu_pclk", "pcu_wclk", "pvt_pclk";
		};

		top_clk_gate2 {
			compatible = "zxic,zx-gate";
			reg = <0x00 0x10e10038 0x00 0x04>;
			#clock-cells = <0x01>;
			zx-clock,ignore-unused = <0x00 0x01 0x01 0x00 0x00 0x01 0x01 0x01 0x01 0x01 0x01 0x01 0x01 0x01 0x01 0x01 0x01 0x01 0x01 0x01>;
			zx-clock,set-rate-parent = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
			clock-indices = <0x05 0x06 0x08 0x09 0x0a 0x0c 0x0d 0x0e 0x0f 0x10 0x11 0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1c 0x1d>;
			zx-clock,bit-shift = <0x05 0x06 0x08 0x09 0x0a 0x0c 0x0d 0x0e 0x0f 0x10 0x11 0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1c 0x1d>;
			zx-clock,parent-names = "nand_wclk_mux", "sys_hclk", "sys_hclk", "sd_wclk_div", "clk32k768", "clk100m", "osc25m", "clk32k768", "sys_pclk", "spifc_wclk_mux", "cci_aclk", "sys_aclk", "clk100m", "osc25m", "clk32k768", "sys_pclk", "sys_aclk", "clk49m152", "sys_hclk", "sec_wclk_mux";
			clock-output-names = "nand_xclk", "nand_hclk", "sd_hclk", "sd_wclk", "sd_cdet_clk", "lsp0_100m", "lsp0_25m", "lsp0_32k", "lsp0_pclk", "spifc_wclk", "ipsec_wclk", "ipsec_aclk", "lsp1_100m", "lsp1_25m", "lsp1_32k", "lsp1_pclk", "lsp1_aclk", "lsp1_49m152", "sec_hclk", "sec_wclk";
			phandle = <0x26>;
		};

		top_clk_gate3 {
			compatible = "zxic,zx-gate";
			reg = <0x00 0x10e1003c 0x00 0x04>;
			#clock-cells = <0x01>;
			zx-clock,ignore-unused = <0x00 0x00 0x00 0x00 0x00>;
			zx-clock,set-rate-parent = <0x00 0x00 0x00 0x00 0x00>;
			clock-indices = <0x00 0x01 0x04 0x05 0x06>;
			zx-clock,bit-shift = <0x00 0x01 0x04 0x05 0x06>;
			zx-clock,parent-names = "sys_pclk", "cci_aclk", "sys_pclk", "cci_aclk", "sys_aclk";
			clock-output-names = "pcie_pclk", "pcie_cci_aclk", "usb_pclk", "usb_cci_aclk", "usb_aclk";
			phandle = <0x23>;
		};

		top_clk_gate4 {
			compatible = "zxic,zx-gate";
			reg = <0x00 0x10e10040 0x00 0x04>;
			#clock-cells = <0x01>;
			zx-clock,ignore-unused = <0x00 0x00 0x00 0x00 0x00>;
			zx-clock,set-rate-parent = <0x00 0x00 0x00 0x00 0x00>;
			clock-indices = <0x00 0x08 0x09 0x0a 0x0b>;
			zx-clock,bit-shift = <0x00 0x08 0x09 0x0a 0x0b>;
			zx-clock,parent-names = "clk1m22", "sys_pclk", "pon_tm_aclk", "cci_aclk", "sys_aclk";
			clock-output-names = "tempsensor_wclk", "tzc400_pclk", "tzc400_pon_aclk", "tzc400_cci_aclk", "tzc400_matrix_aclk";
			phandle = <0x0f>;
		};

		top_clk_gate5 {
			compatible = "zxic,zx-gate";
			reg = <0x00 0x10e10044 0x00 0x04>;
			#clock-cells = <0x01>;
			zx-clock,ignore-unused = <0x01 0x01 0x01 0x01>;
			zx-clock,set-rate-parent = <0x00 0x00 0x00 0x00>;
			clock-indices = <0x00 0x04 0x08 0x09>;
			zx-clock,bit-shift = <0x00 0x04 0x08 0x09>;
			zx-clock,parent-names = "sys_pclk", "cci_aclk", "sys_pclk", "cci_aclk", "clk50m";
			clock-output-names = "pon_serdes_pclk", "gephy_pclk", "uni_serdes_pclk", "uni_serdes_50m_clk";
		};

		top_clk_gate6 {
			compatible = "zxic,zx-gate";
			reg = <0x00 0x10e10048 0x00 0x04>;
			#clock-cells = <0x01>;
			zx-clock,ignore-unused = <0x01 0x01 0x01 0x01>;
			zx-clock,set-rate-parent = <0x00 0x00 0x00 0x00>;
			clock-indices = <0x00 0x01 0x02 0x04 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c>;
			zx-clock,bit-shift = <0x00 0x01 0x02 0x04 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c>;
			zx-clock,parent-names = "sys_aclk", "sys_aclk", "sys_pclk", "pon_core_clk_mux", "clk125m", "clk125m", "pon_rgmii_clk_mux", "pon_woe0_wclk_mux", "pon_nppt_wclk_mux", "clk1m", "clk250m";
			clock-output-names = "pon_idm_aclk", "pon_tm_aclk", "pon_pclk", "pon_core_wclk", "pon_synce_clk", "pon_smac_clk", "pon_rgmii_clk", "pon_woe0_wclk", "pon_woe1_wclk", "pon_1m_clk", "pon_mac_clk";
		};
	};

	lsp0_clk {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;
		zx-clock,parent-names-wclk = "lsp0_25m", "lsp0_100m";
		zx-clock,parent-names-bclk = "lsp0_pclk";
		clock-indices = <0x00 0x01>;
		zx-clock,bit-shift = <0x00 0x01>;

		timer0_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x03 0x04>;
			#clock-cells = <0x01>;
			zx-clock,parent-names-wclk = "lsp0_32k", "lsp0_25m";
			zx-clock,div-bits = <0x0b 0x04>;
			zx-clock,mux-bits = <0x09 0x01>;
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x04>;
			clock-output-names = "timer0_pclk", "timer0_wclk";
		};

		uart0_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x03 0x24>;
			#clock-cells = <0x01>;
			zx-clock,mux-bits = <0x09 0x01>;
			zx-clock,reset-bit = <0x04>;
			clock-output-names = "uart0_pclk", "uart0_wclk";
			phandle = <0x11>;
		};

		uart1_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x03 0x28>;
			#clock-cells = <0x01>;
			zx-clock,mux-bits = <0x09 0x01>;
			zx-clock,reset-bit = <0x04>;
			clock-output-names = "uart1_pclk", "uart1_wclk";
			phandle = <0x12>;
		};

		uart2_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x03 0x34>;
			#clock-cells = <0x01>;
			zx-clock,mux-bits = <0x09 0x01>;
			zx-clock,reset-bit = <0x04>;
			clock-output-names = "uart2_pclk", "uart2_wclk";
			phandle = <0x13>;
		};

		spifc_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x03 0x2c>;
			#clock-cells = <0x01>;
			zx-clock,parent-names-wclk = "spifc_wclk";
			zx-clock,div-bits = <0x0b 0x06>;
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x04>;
			clock-output-names = "sfc_pclk", "sfc_wclk";
			phandle = <0x2d>;
		};
	};

	lsp1_clk {
		zx-clock,parent-names-wclk = "lsp1_25m", "lsp1_100m";
		zx-clock,parent-names-bclk = "lsp1_pclk";
		clock-indices = <0x00 0x01>;
		zx-clock,bit-shift = <0x00 0x01>;

		mdio0_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x04>;
			#clock-cells = <0x01>;
			zx-clock,div-bits = <0x0b 0x07>;
			zx-clock,parent-names-wclk = "lsp1_100m";
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x04>;
			clock-output-names = "mdio0_pclk", "mdio0_wclk";
			phandle = <0x24>;
		};

		mdio1_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x08>;
			#clock-cells = <0x01>;
			zx-clock,div-bits = <0x0b 0x07>;
			zx-clock,parent-names-wclk = "lsp1_100m";
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x04>;
			clock-output-names = "mdio1_pclk", "mdio1_wclk";
			phandle = <0x25>;
		};

		i2c0_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x0c>;
			#clock-cells = <0x01>;
			zx-clock,mux-bits = <0x09 0x01>;
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x04>;
			clock-output-names = "i2c0_pclk", "i2c0_wclk";
			phandle = <0x14>;
		};

		i2c1_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x10>;
			#clock-cells = <0x01>;
			zx-clock,mux-bits = <0x09 0x01>;
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x04>;
			clock-output-names = "i2c1_pclk", "i2c1_wclk";
			phandle = <0x15>;
		};

		ssp0_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x14>;
			#clock-cells = <0x01>;
			zx-clock,mux-bits = <0x09 0x01>;
			zx-clock,div-bits = <0x0b 0x06>;
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x04>;
			clock-output-names = "ssp0_pclk", "ssp0_wclk";
			phandle = <0x33>;
		};

		ssp1_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x18>;
			#clock-cells = <0x01>;
			zx-clock,mux-bits = <0x09 0x01>;
			zx-clock,div-bits = <0x0b 0x06>;
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x04>;
			clock-output-names = "ssp1_pclk", "ssp1_wclk";
			phandle = <0x35>;
		};

		zsi0_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x1c>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x04>;
			clock-output-names = "zsi0_pclk", "zsi0_wclk";
			phandle = <0x38>;
		};

		zsi1_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x20>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x04>;
			clock-output-names = "zsi1_pclk", "zsi1_wclk";
			phandle = <0x3e>;
		};

		isi0_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x24>;
			#clock-cells = <0x01>;
			zx-clock,div-bits = <0x08 0x07>;
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x03>;
			clock-output-names = "isi0_pclk", "isi0_wclk";
			phandle = <0x39>;
		};

		isi1_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x28>;
			#clock-cells = <0x01>;
			zx-clock,div-bits = <0x08 0x07>;
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x03>;
			clock-output-names = "isi1_pclk", "isi1_wclk";
			phandle = <0x3f>;
		};

		tdm0_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x2c>;
			#clock-cells = <0x01>;
			zx-clock,parent-names-wclk = "lsp1_49m152";
			zx-clock,div-bits = <0x08 0x09>;
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x04 0x05>;
			clock-output-names = "tdm0_pclk", "tdm0_wclk";
			phandle = <0x37>;
		};

		tdm1_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x30>;
			#clock-cells = <0x01>;
			zx-clock,parent-names-wclk = "lsp1_49m152";
			zx-clock,div-bits = <0x08 0x09>;
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x04 0x05>;
			clock-output-names = "tdm1_pclk", "tdm1_wclk";
			phandle = <0x3d>;
		};

		wdt0_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x34>;
			#clock-cells = <0x01>;
			zx-clock,div-bits = <0x0b 0x0a>;
			zx-clock,parent-names-wclk = "lsp1_32k";
			clock-output-names = "wdt0_pclk", "wdt0_wclk";
			phandle = <0x16>;
		};

		wdt1_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x38>;
			#clock-cells = <0x01>;
			zx-clock,div-bits = <0x0b 0x0a>;
			zx-clock,parent-names-wclk = "lsp1_32k";
			clock-output-names = "wdt1_pclk", "wdt1_wclk";
			phandle = <0x18>;
		};

		wdt2_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x3c>;
			#clock-cells = <0x01>;
			zx-clock,div-bits = <0x0b 0x0a>;
			zx-clock,parent-names-wclk = "lsp1_32k";
			clock-output-names = "wdt2_pclk", "wdt2_wclk";
		};

		wdt3_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x40>;
			#clock-cells = <0x01>;
			zx-clock,div-bits = <0x0b 0x0a>;
			zx-clock,parent-names-wclk = "lsp1_32k";
			clock-output-names = "wdt3_pclk", "wdt3_wclk";
		};

		i2s0_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x44>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x06>;
			clock-output-names = "i2s0_pclk", "i2s0_wclk";
			phandle = <0x19>;
		};

		i2s1_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x48>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x06>;
			clock-output-names = "i2s1_pclk", "i2s1_wclk";
			phandle = <0x1b>;
		};

		i2s2_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x4c>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x06>;
			clock-output-names = "i2s2_pclk", "i2s2_wclk";
			phandle = <0x1d>;
		};

		pwm_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x50>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			zx-clock,reset-bit = <0x04>;
			clock-output-names = "pwm_pclk", "pwm_wclk";
			phandle = <0x1f>;
		};

		efuse_clk {
			compatible = "zxic,zx-clk-lsp-regmap";
			zx-clock,regmap = <0x04 0x54>;
			#clock-cells = <0x01>;
			clock-output-names = "efuse_pclk", "efuse_wclk";
			phandle = <0x22>;
		};
	};

	aliases {
		serial0 = "/soc/serial@10d0d000";
		serial1 = "/soc/serial@10d0e000";
		mmc = "/soc/dwmmc0@0x08a00000";
		wdt0 = "/soc/wdt@14f09000";
		wdt1 = "/soc/wdt@14f0a000";
		i2c0 = "/soc/i2c@14f03000";
		i2c1 = "/soc/i2c@14f04000";
		mdio0 = "/soc/mdio@14f01000";
		mdio1 = "/soc/mdio@14f02000";
		gpio0 = "/soc/gpio@10d10000";
		gpio1 = "/soc/gpio@10d10040";
		gpio2 = "/soc/gpio@10d10080";
		gpio3 = "/soc/gpio@10d100c0";
		gpio4 = "/soc/gpio@10d10100";
		nand = "/soc/nand@01000000";
		spifc = "/soc/spifc@0x10d0f000";
		pcie0 = "/soc/pcie@15200000";
		msi0 = "/soc/msi@1f000000";
		pcie1 = "/soc/pcie@15202000";
		msi1 = "/soc/msi@1f400000";
	};

	opp_table0 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x0b>;

		opp@500000000 {
			opp-hz = <0x00 0x1dcd6500>;
			opp-microvolt = <0xcd910>;
			clock-latency-ns = <0x493e0>;
			opp-suspend;
		};

		opp@688000000 {
			opp-hz = <0x00 0x29020c00>;
			opp-microvolt = <0xcf850>;
			clock-latency-ns = <0x493e0>;
		};

		opp@900000000 {
			opp-hz = <0x00 0x35a4e900>;
			opp-microvolt = <0xd1790>;
			clock-latency-ns = <0x493e0>;
		};

		opp@1000000000 {
			opp-hz = <0x00 0x3b9aca00>;
			opp-microvolt = <0xd1790>;
			clock-latency-ns = <0x493e0>;
		};

		opp@1100000000 {
			opp-hz = <0x00 0x4190ab00>;
			opp-microvolt = <0xd32e8>;
			clock-latency-ns = <0x4baf0>;
			turbo-mode;
		};

		opp@1200000000 {
			opp-hz = <0x00 0x47868c00>;
			opp-microvolt = <0xd5228>;
			clock-latency-ns = <0x46cd0>;
			turbo-mode;
		};

		opp@1300000000 {
			opp-hz = <0x00 0x4d7c6d00>;
			opp-microvolt = <0xd5228>;
			clock-latency-ns = <0x46cd0>;
			turbo-mode;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x05>;
				};

				core1 {
					cpu = <0x06>;
				};
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cpu-sleep-0 {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x28>;
				exit-latency-us = <0x64>;
				min-residency-us = <0x96>;
				phandle = <0x08>;
			};

			cluster-sleep-0 {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x1010000>;
				entry-latency-us = <0x1f4>;
				exit-latency-us = <0x3e8>;
				min-residency-us = <0x9c4>;
				phandle = <0x09>;
			};
		};

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53", "arm,armv8";
			reg = <0x00 0x00>;
			clocks = <0x07 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x08 0x09>;
			cpu-supply = <0x0a>;
			operating-points-v2 = <0x0b>;
			clock-frequency = <0x3b9aca00>;
			phandle = <0x05>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53", "arm,armv8";
			reg = <0x00 0x01>;
			clocks = <0x07 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x08 0x09>;
			cpu-supply = <0x0a>;
			operating-points-v2 = <0x0b>;
			clock-frequency = <0x3b9aca00>;
			phandle = <0x06>;
		};
	};

	psci {
		compatible = "arm,psci-0.2", "arm,psci";
		method = "smc";
		cpu_suspend = <0xc4000001>;
		cpu_off = <0x84000002>;
		cpu_on = <0xc4000003>;
		sys_poweroff = <0x84000008>;
		sys_reset = <0x84000009>;
	};

	interrupt-controller@00500000 {
		compatible = "arm,gic-v3";
		reg = <0x00 0x500000 0x00 0x10000 0x00 0x540000 0x00 0x80000>;
		#interrupt-cells = <0x03>;
		interrupt-controller;
		interrupts = <0x01 0x09 0x04>;
		phandle = <0x01>;
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0x308 0x01 0x0e 0x308 0x01 0x0b 0x308 0x01 0x0a 0x308>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x20000000>;
	};

	iram@200000 {
		compatible = "zte,iram";
		reg = <0x00 0x200000 0x00 0x100000>;
		status = "disabled";
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		boot_ctrl@10e10170 {
			compatible = "zxic,boot-ctrl", "syscon";
			reg = <0x00 0x10e10170 0x00 0x04>;
		};

		toprst@10e10060 {
			compatible = "zte,zx296718-reset";
			reg = <0x00 0x10e10060 0x00 0x04>;
			#reset-cells = <0x01>;
			phandle = <0x27>;
		};

		localrst@10e10070 {
			compatible = "zte,zx296718-reset";
			reg = <0x00 0x10e10070 0x00 0x08>;
			#reset-cells = <0x01>;
		};

		topcrm@10e10000 {
			compatible = "zte,zx279133-topcrm", "syscon";
			reg = <0x00 0x10e10000 0x00 0x10000>;
			phandle = <0x17>;
		};

		lsp_crm@10d00000 {
			compatible = "zxic,lsp-clock", "syscon";
			reg = <0x00 0x10d00000 0x00 0x100>;
			phandle = <0x03>;
		};

		lsp_crm@14f00000 {
			compatible = "zte,lsp1_crm", "zxic,lsp-clock", "syscon";
			reg = <0x00 0x14f00000 0x00 0x100>;
			phandle = <0x04>;
		};

		sys_ctrl {
			compatible = "zte,zx279133-sysctrl", "syscon";
			reg = <0x00 0x10e00000 0x00 0x10000>;
		};

		rstctrl {
			compatible = "zxic,zx-rstctrl", "syscon";
			reg = <0x00 0x10e10208 0x00 0x04>;
			phandle = <0x0c>;
		};

		reboot@10e10204 {
			compatible = "zxic,zx-reboot";
			reg = <0x00 0x10e10204 0x00 0x04>;
			bit = <0x00>;
			reboot-config = <0x0c 0x00 0x01>;
		};

		pinctrl@10e20000 {
			compatible = "zte,zx-pinctrl";
			reg = <0x00 0x10e20000 0x00 0x1000>;
			pinctrl-zx,bank-range-0 = <0x0d 0x05 0x03 0x0d 0x01 0x02 0x0d 0x02 0x01 0x0d 0x02 0x02 0x0d 0x02 0x01 0x0d 0x03 0x02>;
			pinctrl-zx,bank-range-1 = <0x0d 0x02 0x03 0x0d 0x03 0x02 0x0d 0x03 0x03 0x0d 0x02 0x02>;
			pinctrl-zx,bank-range-2 = <0x0d 0x02 0x02 0x0d 0x07 0x01 0x0d 0x02 0x02 0x0d 0x01 0x03 0x0d 0x06 0x01>;
			pinctrl-zx,bank-range-3 = <0x0d 0x06 0x03 0x0d 0x07 0x02>;
			pinctrl-zx,bank-range-4 = <0x0d 0x02 0x02 0x0d 0x08 0x01>;
			pinctrl-zx,bank-range-5 = <0x0d 0x04 0x02>;
			pinctrl-zx,pinconf-names = "pu_bit", "pd_bit", "st_bit", "ds_shift", "ds_width";
			pinctrl-zx,pinconfs = [00 01 02 03 03];
			pinctrl-zx,bits-per-conf = [06];
			pinctrl-zx,gpio-range = <0x0e 0x00 0x05 0x03 0x0e 0x05 0x03 0x01 0x0e 0x08 0x02 0x03 0x0e 0x0a 0x02 0x01 0x0e 0x0c 0x02 0x03 0x0e 0x0e 0x01 0x01 0x0e 0x0f 0x02 0x03 0x0e 0x11 0x02 0x01 0x0e 0x13 0x04 0x03 0x0e 0x17 0x01 0x01 0x0e 0x18 0x01 0x02 0x0e 0x19 0x02 0x03 0x0e 0x1b 0x07 0x01 0x0e 0x22 0x02 0x02 0x0e 0x24 0x01 0x03 0x0e 0x25 0x06 0x01 0x0e 0x2b 0x06 0x03 0x0e 0x31 0x02 0x02 0x0e 0x33 0x01 0x01 0x0e 0x34 0x04 0x02 0x0e 0x38 0x02 0x02 0x0e 0x3a 0x08 0x01 0x0e 0x42 0x01 0x03 0x0e 0x43 0x01 0x02 0x0e 0x44 0x02 0x03>;
			pinctrl-zx,pinconf-bank = <0x50 0x0b 0x0e 0x01 0x50 0x11 0x00 0x0e 0x5c 0x0c 0x0f 0x0a 0x64 0x18 0x42 0x04 0x68 0x12 0x19 0x29>;
			phandle = <0x10>;

			gpio-range {
				#pinctrl-zx,gpio-range-cells = <0x03>;
				phandle = <0x0e>;
			};

			bank-range {
				#pinctrl-zx,bank-range-cells = <0x02>;
				phandle = <0x0d>;
			};

			i2c0-pins {
				function = "i2c0";
				pins = "p0-6", "p0-7";
				configs = [00 00];
			};

			i2c1-pins {
				function = "i2c1";
				pins = "p0-8", "p0-9";
				configs = [00 00];
			};

			i2s0-pins {
				function = "i2s0";
				pins = "p2-10", "p2-11", "p3-6", "p3-7", "p3-8";
				configs = [03 04 03 03 02];
				phandle = <0x1a>;
			};

			i2s1-pins {
				function = "i2s1";
				pins = "p0-1", "p0-2", "p0-3", "p0-4", "p0-5";
				configs = [05 05 05 05 03];
				phandle = <0x1c>;
			};

			i2s2-pins {
				function = "i2s2";
				pins = "p3-0", "p3-1", "p3-2", "p3-3", "p3-4", "p3-5";
				configs = [04 04 04 04 04 04];
				phandle = <0x1e>;
			};

			pwm_pins {
				function = "pwm";
				pins = "p0-8", "p0-9", "p0-12", "p0-13";
				configs = <0x1010202>;
				phandle = <0x20>;
			};

			mdio0-pins {
				function = "mdio0";
				pins = "p2-10", "p2-11";
				configs = [00 00];
			};

			mdio1-pins {
				function = "mdio1";
				pins = "p2-0", "p2-1";
				configs = [00 00];
			};

			mmc-pins {
				function = "mmc";
				pins = "p3-0", "p3-1", "p3-2", "p3-3", "p3-4", "p3-5", "p3-6", "p3-7";
				configs = <0x1010101 0x1010101>;
				phandle = <0x28>;
			};

			nand_pins {
				function = "nand";
				pins = "p3-0", "p3-1", "p3-2", "p3-3", "p3-4", "p3-5", "p3-6", "p3-7", "p3-8", "p3-9", "p3-10", "p3-11", "p3-12", "p4-0", "p4-1";
				configs = [00 00 00 00 00 00 00 00 00 00 00 00 00 00 00];
				phandle = <0x29>;
			};

			spifc-pins {
				function = "spifc";
				pins = "p3-9", "p3-10", "p3-11", "p3-12", "p4-0", "p4-1";
				configs = [01 01 01 01 01 01];
				phandle = <0x2e>;
			};

			pcie0-pins {
				function = "pcie0";
				pins = "p4-2", "p4-3";
				configs = [00 00];
				phandle = <0x30>;
			};

			pcie1-pins {
				function = "pcie1";
				pins = "p4-4", "p4-5";
				configs = [00 00];
				phandle = <0x31>;
			};

			lan_led0_pins {
				function = "lan_led0";
				pins = "p4-6";
				configs = [00];
			};

			lan_led1_pins {
				function = "lan_led1";
				pins = "p4-7";
				configs = [00];
			};

			lan_led2_pins {
				function = "lan_led2";
				pins = "p4-8";
				configs = [00];
			};

			lan_led3_pins {
				function = "lan_led3";
				pins = "p4-9";
				configs = [00];
			};

			pon_plat_pins {
				function = "pon_ben";
				pins = "p2-2";
				configs = [00];
			};

			ssp0-pins {
				function = "ssp0";
				pins = "p1-0", "p1-1", "p1-2", "p1-3", "p1-4";
				configs = [00 00 00 00 00];
				phandle = <0x34>;
			};

			ssp1-pins {
				function = "ssp1";
				pins = "p1-5", "p1-6", "p1-7", "p1-8", "p1-9";
				configs = [00 00 00 00 00];
				phandle = <0x36>;
			};

			zsi_pins {
				function = "zsi";
				pins = "p5-0", "p5-1", "p5-2", "p5-3";
				configs = <0x1010101>;
				phandle = <0x3a>;
			};

			zsi1_pins {
				function = "zsi1";
				pins = "p1-0", "p1-1", "p1-2", "p1-3";
				configs = <0x4040202>;
				phandle = <0x40>;
			};

			isi_pins {
				function = "isi";
				pins = "p5-0", "p5-2", "p5-3";
				configs = [02 02 02];
				phandle = <0x3b>;
			};

			isi1_pins {
				function = "isi1";
				pins = "p1-0", "p1-2", "p1-3";
				configs = [05 03 03];
				phandle = <0x41>;
			};

			pcm_pins {
				function = "pcm";
				pins = "p5-0", "p5-1", "p5-2", "p5-3";
				configs = <0x00>;
				phandle = <0x3c>;
			};

			pcm1_pins {
				function = "pcm1";
				pins = "p0-1", "p0-2", "p0-3", "p0-4";
				configs = <0x1010101>;
				phandle = <0x42>;
			};
		};

		pvt@10e70000 {
			compatible = "zxic,zx-pvt-sensor-cln22ulp";
			reg = <0x00 0x10e70000 0x00 0x10000>;
			interrupts = <0x00 0xbe 0x04 0x00 0xbf 0x04 0x00 0xc0 0x04 0x00 0xc1 0x04>;
			clocks = <0x0f 0x00>;
			param-efuse-ttrim-bits = <0x88a 0x05>;
			sensor-wait-time = <0x00>;
			coeff-multiple = <0xf4240>;
			param-calc-temperature = <0x64a1 0x17c34 0x4add 0x782a 0xcbbc>;
			status = "okay";
		};

		bdinfo@0 {
			compatible = "zxic,zx279133-board", "zxic,zx-board";
			boot-mode = <0x10e10170 0x03>;
		};

		gpio@10d10000 {
			compatible = "zte,zx-gpio";
			reg = <0x00 0x10d10000 0x00 0x40>;
			interrupts = <0x00 0x22 0x04>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x10 0x00 0x0e 0x01 0x10 0x01 0x00 0x0e 0x10 0x0f 0x0f 0x01>;
		};

		gpio@10d10040 {
			compatible = "zte,zx-gpio";
			reg = <0x00 0x10d10040 0x00 0x40>;
			interrupts = <0x00 0x23 0x04>;
