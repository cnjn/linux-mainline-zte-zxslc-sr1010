+					u16 ingress_vid = tci & VLAN_VID_MASK;
+
+					if (vhdr->h_vlan_proto == htons(ETH_P_8021Q) &&
+					    (ingress_vid == ZX279133_LAN_INGRESS_VID ||
+					     (ingress_vid >= ZX279133_LAN_SOURCE_PORT_MIN &&
