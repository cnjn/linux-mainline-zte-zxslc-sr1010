+	netdev_tx_t ret;
+
+	if (!(READ_ONCE(eth->datapath_users) & ZX279133_DATAPATH_USER_LAN) ||
+	    !READ_ONCE(eth->lan_datapath_ready) ||
+	    !READ_ONCE(eth->hardware_prepared))
+		return NETDEV_TX_BUSY;
