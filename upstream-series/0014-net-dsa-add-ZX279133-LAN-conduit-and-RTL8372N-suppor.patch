+
+					vhdr = (struct vlan_ethhdr *)skb->data;
+					vlan_header = zx279133_idm_rx_normalize_vlan(vhdr);
+				}
+				if (!vlan_header)
+					zx279133_idm_rx_put_vlan(skb, ZX279133_LAN_VID);
+			}
+			skb->protocol = eth_type_trans(skb, rx_ndev);
