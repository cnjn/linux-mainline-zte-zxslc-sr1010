+			if (lan_dsa_active && lan_source && eth->lan_ndev) {
+				bool vlan_header = false;
+				u16 transport_vid =
+					src_port == ZX279133_LAN_SOURCE_PORT_NATIVE ?
+					ZX279133_LAN_VID : src_port;
+
+				rx_ndev = eth->lan_ndev;
+				if (len >= sizeof(struct vlan_ethhdr)) {
