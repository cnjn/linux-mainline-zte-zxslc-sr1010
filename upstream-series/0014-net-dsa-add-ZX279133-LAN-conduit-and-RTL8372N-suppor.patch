+	ndev->hw_features = eth->ndev->hw_features;
+	ndev->vlan_features = eth->ndev->vlan_features;
+	eth_hw_addr_set(ndev, eth->ndev->dev_addr);
+	netif_carrier_off(ndev);
+
+out_unlock:
+	mutex_unlock(&eth->datapath_lock);
+	return ret;
