+obj-$(CONFIG_ZTE_ZX279133_XPCS_NPPT_AUDIT) += zx279133-xpcs-nppt-audit.o
diff --git a/drivers/soc/zte/zx279133-xpcs-nppt-audit.c b/drivers/soc/zte/zx279133-xpcs-nppt-audit.c
