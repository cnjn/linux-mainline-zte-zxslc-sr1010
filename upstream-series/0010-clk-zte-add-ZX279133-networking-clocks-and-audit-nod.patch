@@ -10,3 +10,14 @@ config ZTE_ZX279133_PWM_AUDIT
 	  It obtains clock handles only to verify the firmware-enabled gate state;
 	  it never prepares or enables them. The driver registers no PWM chip,
 	  requests no resets or pinctrl, and performs no hardware writes.
+
+config ZTE_ZX279133_XPCS_NPPT_AUDIT
+	bool "ZTE ZX279133 XPCS and NPPT read-only audit"
+	depends on COMMON_CLK_ZX279133
+	depends on (ARM64 || COMPILE_TEST) && HAS_IOMEM
+	help
+	  Build a diagnostic driver exposing a trigger-once sysfs snapshot of
+	  firmware-configured XPCS and NPPT registers. A dedicated external build
+	  overlay instantiates this driver; normal system device trees do not.
+	  Target data reads are trigger-once, and clock validation checks are not
+	  included in data_reads. The driver never changes clock or hardware state.
