index a844e539b453e8301de757feb709cc21d42deb39..924dae0f7f92bae6c312955a6f08a1568b7420ad 100644
--- a/drivers/net/mdio/Kconfig
+++ b/drivers/net/mdio/Kconfig
@@ -113,6 +113,26 @@ config MDIO_ZX279133
 	  peripheral and working clocks and provides bounded polling for both
 	  native transaction formats.
 
+config MDIO_SR1010_RTL8372N_AUDIT
+	bool "ZTE SR1010 RTL8372N read-only chip ID audit"
+	depends on MDIO_ZX279133
+	help
+	  Enable a test-only non-PHY MDIO child that performs exactly two fixed
+	  read-only chip ID transactions against the SR1010 RTL8372N switch.
+	  The audit fails closed unless attached to the expected MDIO controller
+	  and address, and a one-shot guard prevents any repeated bus access.
+	  This option is intended only for isolated RAM-boot hardware validation.
+
+config MDIO_SR1010_ZX279051_AUDIT
+	bool "ZTE SR1010 ZX279051 read-only identification audit"
+	depends on MDIO_ZX279133
+	help
+	  Enable a test-only MDIO child that performs exactly two fixed Clause 45
+	  identification reads from the SR1010 WAN PHY. This is intended only for
+	  isolated RAM-boot hardware validation and has no write operation. The
+	  audit fails closed unless it is attached to MDIO1 at its exact address,
+	  and a one-shot guard prevents the reads from being repeated after probe.
+
 config MDIO_I2C
 	tristate
 	depends on I2C
