+
+properties:
+  compatible:
+    const: zte,sr1010-zx279051-audit
+
+  reg:
+    const: 1
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    mdio {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        wan-audit@1 {
+            compatible = "zte,sr1010-zx279051-audit";
+            reg = <1>;
+        };
+    };
+
+...
