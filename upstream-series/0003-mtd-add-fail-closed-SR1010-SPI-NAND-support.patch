From b3318777b36bd3938a69728fe154cf3342d40419 Mon Sep 17 00:00:00 2001
From: cnjn <1779895255@qq.com>
Date: Sat, 22 Aug 2026 20:00:11 +0800
Subject: [PATCH 03/16] mtd: add fail-closed SR1010 SPI NAND support

Consolidate 6 validated ZX279133 development commits into one functional stage.

Original range: 39dd2ed0d625a4a12cc14f2f9e5ad0f4290bf53d..32d91a90be9aef609f348e306d18235a8930c098

Signed-off-by: cnjn <1779895255@qq.com>
---
 .../devicetree/bindings/mtd/spi-nand.yaml     |  35 ++++
 arch/arm64/boot/dts/zte/zx279133-sr1010.dts   |  17 ++
 drivers/mtd/mtdcore.c                         |  77 ++++++--
 drivers/mtd/nand/spi/core.c                   | 182 ++++++++++++++++--
 drivers/mtd/nand/spi/winbond.c                | 100 +++++++++-
 include/linux/mtd/mtd.h                       |   3 +
 include/linux/mtd/spinand.h                   |  20 ++
 7 files changed, 405 insertions(+), 29 deletions(-)

diff --git a/Documentation/devicetree/bindings/mtd/spi-nand.yaml b/Documentation/devicetree/bindings/mtd/spi-nand.yaml
index 77a8727c79661fcc71aa60415fbb5b1ee607dabb..257459f9c183a63a77c01e83e2caa98940602404 100644
--- a/Documentation/devicetree/bindings/mtd/spi-nand.yaml
+++ b/Documentation/devicetree/bindings/mtd/spi-nand.yaml
@@ -12,6 +12,21 @@ maintainers:
 allOf:
   - $ref: nand-chip.yaml#
   - $ref: /schemas/spi/spi-peripheral-props.yaml#
+  - if:
+      anyOf:
+        - required:
+            - read-only
+        - required:
+            - partitions-only
+    then:
+      required:
+        - partitions
+      properties:
+        partitions:
+          properties:
+            compatible:
+              contains:
+                const: fixed-partitions
 
 properties:
   compatible:
@@ -21,6 +36,26 @@ properties:
     description: Encode the chip-select line on the SPI bus
     maxItems: 1
 
+  read-only:
+    type: boolean
+    description:
+      Operate the chip in strict read-only mode. Reset and commands needed to
+      identify and read the device are permitted, but commands that alter
+      feature registers, protection state, OTP data, or the main NAND array
+      are not. Probe succeeds only if the post-reset feature state already
+      permits reliable on-die-ECC-protected main-array and bad block marker
+      reads. Raw reads that would require disabling on-die ECC are not
+      supported. A fixed partition map is required and only its partitions are
+      registered, so parser failure cannot expose the whole chip.
+
+  partitions-only:
+    type: boolean
+    description:
+      The firmware requires that only explicitly described fixed partitions
+      are exposed. Initialization fails if the map is missing or cannot be
+      parsed, instead of exposing the whole flash device. This permits a
+      writable chip to expose only explicitly described partitions.
+
 required:
   - compatible
   - reg
diff --git a/arch/arm64/boot/dts/zte/zx279133-sr1010.dts b/arch/arm64/boot/dts/zte/zx279133-sr1010.dts
index 769a667e28ac53817fc579369f4471df7db2ed3e..5e0afb57908353dd85287546abb3c1c0bdb30568 100644
--- a/arch/arm64/boot/dts/zte/zx279133-sr1010.dts
+++ b/arch/arm64/boot/dts/zte/zx279133-sr1010.dts
@@ -76,3 +76,20 @@ &usb3 {
 &pvt {
 	status = "okay";
 };
+
+&spifc {
+	/* Keep SFC timing conservative until it is characterized on hardware. */
+	spi-max-frequency = <25000000>;
+	status = "okay";
+
+	flash@0 {
+		read-only;
+		spi-max-frequency = <25000000>;
+
+		partitions {
+			partition@100000 {
+				read-only;
+			};
+		};
+	};
+};
