+
+		ret = mtd_device_parse_register_partitions_only(mtd, ofpart_types, NULL);
+	} else {
+		ret = mtd_device_register(mtd, NULL, 0);
+	}
 	if (ret)
 		goto err_spinand_cleanup;
 
