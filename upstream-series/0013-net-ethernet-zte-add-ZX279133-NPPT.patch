+static int zx279133_spa_pkt_type_runtime(struct zx279133_eth *eth)
+{
+	static const u16 idx[] = { 0, 1, 128, 129 };
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(idx); i++) {
+		int ret = zx279133_spa_indirect_write(eth, 0x40, idx[i],
+						      0x00f7c000);
+
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
