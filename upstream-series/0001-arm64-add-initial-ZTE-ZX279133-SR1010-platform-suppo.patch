diff --git a/Documentation/devicetree/bindings/clock/zte,zx279133-topcrm.yaml b/Documentation/devicetree/bindings/clock/zte,zx279133-topcrm.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..f3d5528224cbda100968643ba350bd812bafb9ad
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/zte,zx279133-topcrm.yaml
@@ -0,0 +1,76 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/zte,zx279133-topcrm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: ZTE ZX279133 top clock and reset manager
+
+maintainers:
+  - cnjn <1779895255@qq.com>
+
+description:
+  The top clock and reset manager (TOPCRM) supplies clocks to the ZX279133
+  low-speed peripheral controllers, SPI flash controller, PVT temperature
+  sensor, and USB host controller. The PVT working clock uses a read-only
+  divider followed by a gate. The USB clocks are gate3 outputs with fixed-rate
+  system and CCI parent inputs until the full PLL/mux tree is modeled.
+
+properties:
+  compatible:
+    items:
+      - const: zte,zx279133-topcrm
+      - const: syscon
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: 100 MHz LSP working clock source
+      - description: 25 MHz oscillator
+      - description: 125 MHz system peripheral bus clock
+      - description: 32.768 kHz LSP working clock source
+      - description: 50 MHz PVT divider source
+      - description: 125 MHz system peripheral clock parent for USB
+      - description: 500 MHz CCI clock parent for USB
+      - description: 250 MHz system AXI clock parent for USB
+
+  clock-names:
+    items:
+      - const: clk100m
+      - const: clk25m
+      - const: pclk
+      - const: clk32k
+      - const: clk50m
+      - const: sys_pclk
+      - const: cci_aclk
+      - const: sys_aclk
+
+  '#clock-cells':
+    const: 1
+    description:
+      See include/dt-bindings/clock/zte,zx279133-topcrm.h for valid indices.
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - '#clock-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-controller@10e10000 {
+        compatible = "zte,zx279133-topcrm", "syscon";
+        reg = <0x10e10000 0x60>;
+        clocks = <&clk100m>, <&osc25m>, <&clk125m>, <&clk32k>, <&clk50m>,
+                 <&clk125m>, <&cci_aclk>, <&sys_aclk>;
+        clock-names = "clk100m", "clk25m", "pclk", "clk32k", "clk50m",
+                      "sys_pclk", "cci_aclk", "sys_aclk";
+        #clock-cells = <1>;
+    };
+
+...
diff --git a/Documentation/devicetree/bindings/gpio/zte,zx279133-gpio.yaml b/Documentation/devicetree/bindings/gpio/zte,zx279133-gpio.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..2571aacebf33a551177bfe13c79fa99c085ec62e
--- /dev/null
+++ b/Documentation/devicetree/bindings/gpio/zte,zx279133-gpio.yaml
@@ -0,0 +1,72 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/gpio/zte,zx279133-gpio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: ZTE ZX279133 GPIO controller
+
+maintainers:
+  - ZTE Linux Team <zte.linux@gmail.com>
+
+description: |
+  The ZX279133 has five GPIO banks with 16-bit registers and one cascaded
+  interrupt per bank. Four banks expose 16 lines and the final bank exposes
+  six lines, for 70 GPIOs in total.
+
+properties:
+  $nodename:
+    pattern: "^gpio@[0-9a-f]+$"
+
+  compatible:
+    const: zte,zx279133-gpio
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  gpio-controller: true
+
+  '#gpio-cells':
+    const: 2
+
+  gpio-ranges:
+    minItems: 1
+    maxItems: 3
+
+  ngpios:
+    enum: [6, 16]
+
+  interrupt-controller: true
+
+  '#interrupt-cells':
+    const: 2
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - gpio-controller
+  - '#gpio-cells'
+  - gpio-ranges
+  - ngpios
+  - interrupt-controller
+  - '#interrupt-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    gpio@10d10080 {
+        compatible = "zte,zx279133-gpio";
+        reg = <0x10d10080 0x40>;
+        interrupts = <0 36 4>;
+        gpio-controller;
+        #gpio-cells = <2>;
+        gpio-ranges = <&pinctrl 0 28 16>;
+        ngpios = <16>;
+        interrupt-controller;
+        #interrupt-cells = <2>;
+    };
diff --git a/Documentation/devicetree/bindings/hwmon/zte,zx279133-pvt.yaml b/Documentation/devicetree/bindings/hwmon/zte,zx279133-pvt.yaml
new file mode 100644
