--- /dev/null
+++ b/Documentation/devicetree/bindings/hwmon/zte,zx279133-pvt.yaml
@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/hwmon/zte,zx279133-pvt.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: ZTE ZX279133 CLN22ULP PVT temperature sensor
+
+maintainers:
+  - cnjn <1779895255@qq.com>
+
+description: |
+  The ZX279133 CLN22ULP PVT block contains a one-shot die temperature
+  converter.  The driver starts a conversion for each read and exposes only
+  the standard read-only hwmon temperature input.  The optional ttrim NVMEM
+  cell is a five-bit calibration value from the ZX279133 efuse controller.
+  Thermal trips and cooling policy are described by separate thermal-zone
+  nodes and are intentionally not part of this binding.
+
+properties:
+  compatible:
+    const: zte,zx279133-pvt
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    items:
+      - const: wclk
+
+  nvmem-cells:
+    maxItems: 1
+
+  nvmem-cell-names:
+    items:
+      - const: ttrim
+
+  '#thermal-sensor-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - '#thermal-sensor-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    pvt@10e70000 {
+        compatible = "zte,zx279133-pvt";
+        reg = <0x10e70000 0x10000>;
+        clocks = <&topcrm 5>;
+        clock-names = "wclk";
+        #thermal-sensor-cells = <0>;
+        status = "disabled";
+    };
+
+...
