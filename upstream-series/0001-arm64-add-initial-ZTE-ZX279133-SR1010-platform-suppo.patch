index 0000000000000000000000000000000000000000..d02efaf3249a3e515c88f72c809def246222a6d9
--- /dev/null
+++ b/Documentation/devicetree/bindings/spi/zte,zx279133-sfc.yaml
@@ -0,0 +1,92 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/spi/zte,zx279133-sfc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: ZTE ZX279133 SPI flash controller
+
+maintainers:
+  - cnjn <1779895255@qq.com>
+
+description: |
+  The ZX279133 serial flash controller is a single-chip-select SPI-MEM
+  controller used by the board's SPI-NAND. The controller has a 64-byte FIFO
+  and supports single-bit command phases with single, dual, or quad address
+  and data phases.
+
+allOf:
+  - $ref: spi-controller.yaml#
+
+properties:
+  compatible:
+    const: zte,zx279133-sfc
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    minItems: 2
+    maxItems: 2
+
+  clock-names:
+    items:
+      - const: pclk
+      - const: wclk
+
+  resets:
+    maxItems: 1
+
+  zte,spi-chipselect:
+    description:
+      Phandle to the LSP syscon, register offset, and mask used to select the
+      controller chip-select. The single board device uses bit 29 of offset
+      0x2c and selects chip-select zero.
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    items:
+      - items:
+          - description: phandle to the LSP syscon
+          - description: chip-select register offset
+          - description: chip-select mask
+
+  spi-max-frequency:
+    description: Maximum SPI clocking speed of the controller in Hz.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - zte,spi-chipselect
+  - spi-max-frequency
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    spi@10d0f000 {
+        compatible = "zte,zx279133-sfc";
+        reg = <0x10d0f000 0x1000>;
+        interrupts = <33>;
+        clocks = <&sfc_clk 0>, <&sfc_clk 1>;
+        clock-names = "pclk", "wclk";
+        resets = <&sfc_clk 0>;
+        zte,spi-chipselect = <&sfc_clk 0x2c 0x20000000>;
+        spi-max-frequency = <100000000>;
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        flash@0 {
+            compatible = "spi-nand";
+            reg = <0>;
+            spi-max-frequency = <100000000>;
+        };
+    };
+
+...
