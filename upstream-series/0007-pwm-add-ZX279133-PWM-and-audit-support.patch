+++ b/Documentation/devicetree/bindings/pwm/zte,zx279133-pwm.yaml
@@ -0,0 +1,59 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pwm/zte,zx279133-pwm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: ZTE ZX279133 PWM controller
+
+maintainers:
+  - ZTE Linux Team <zte.linux@gmail.com>
+
+description:
+  The ZX279133 PWM controller provides four channels. Each channel has a
+  10-bit clock divider and 16-bit period and duty counters.
+
+allOf:
+  - $ref: pwm.yaml#
+
+properties:
+  compatible:
+    const: zte,zx279133-pwm
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: Peripheral bus clock
+      - description: Waveform generator clock
+
+  clock-names:
+    items:
+      - const: pclk
+      - const: wclk
+
+  "#pwm-cells":
+    const: 3
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - "#pwm-cells"
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/zte,zx279133-lsp.h>
+
+    pwm@14f10000 {
+        compatible = "zte,zx279133-pwm";
+        reg = <0x14f10000 0x1000>;
+        clocks = <&lsp1_clk ZX279133_LSP1_CLK_PWM_PCLK>,
+                 <&lsp1_clk ZX279133_LSP1_CLK_PWM_WCLK>;
+        clock-names = "pclk", "wclk";
+        #pwm-cells = <3>;
+    };
diff --git a/Documentation/devicetree/bindings/soc/zte,zx279133-pwm-audit.yaml b/Documentation/devicetree/bindings/soc/zte,zx279133-pwm-audit.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..86e7f6a16bcbe45c98e9b883947db38878e7c560
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/zte,zx279133-pwm-audit.yaml
@@ -0,0 +1,50 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/zte,zx279133-pwm-audit.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: ZTE ZX279133 PWM read-only audit
+
+maintainers:
+  - ZTE Linux Team <zte.linux@gmail.com>
+
+description: |
+  This diagnostic node reads the raw MODE, PERIOD, and DUTY registers of the
+  firmware-configured PWM controller. It does not register a PWM provider,
+  prepare or enable clocks, request resets, select pinctrl, or modify controller
+  state. The clock references let the driver refuse MMIO access unless firmware
+  has already enabled both controller gates at their expected rates.
+
+properties:
+  compatible:
+    const: zte,zx279133-pwm-audit
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 2
+
+  clock-names:
+    items:
+      - const: pclk
+      - const: wclk
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+
+additionalProperties: false
+
+examples:
+  - |
+    pwm-audit@14f10000 {
+        compatible = "zte,zx279133-pwm-audit";
+        reg = <0x14f10000 0x1000>;
+        clocks = <&lsp1_clk 6>, <&lsp1_clk 7>;
+        clock-names = "pclk", "wclk";
+    };
+...
