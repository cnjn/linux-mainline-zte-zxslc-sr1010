@@ -324,7 +328,7 @@ static int zx279133_topcrm_clk_probe(struct platform_device *pdev)
 	hw = zx279133_register_mux(dev, "sys_aclk", sys_aclk_parents,
 				   ARRAY_SIZE(sys_aclk_parents),
