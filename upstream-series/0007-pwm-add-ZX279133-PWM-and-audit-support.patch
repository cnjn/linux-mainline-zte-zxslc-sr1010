@@ -36,7 +36,11 @@
 #define ZX279133_EFUSE_CLK_CTRL	0x54
 #define ZX279133_EFUSE_PCLK_GATE	0
 #define ZX279133_EFUSE_WCLK_GATE	1
-#define ZX279133_LSP1_NUM_CLKS	(ZX279133_LSP1_CLK_EFUSE_WCLK + 1)
