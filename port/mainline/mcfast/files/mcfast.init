#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	local enabled

	config_load mcfast
	config_get_bool enabled config enabled 1
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/mcfast
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger mcfast
}
