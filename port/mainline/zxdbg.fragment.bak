CONFIG_OF=y
CONFIG_EXPERT=y
CONFIG_IRQ_DOMAIN=y
CONFIG_ARM64_ERRATUM_843419=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_RELOCATABLE=y
CONFIG_ARM64_VA_BITS_39=y
# CONFIG_ARM64_VA_BITS_48 is not set
# CONFIG_ARM64_VA_BITS_52 is not set
# CONFIG_ARM64_LPA2 is not set
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_SMP=y

CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_ZX279133=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_SIMPLE=y
CONFIG_MFD_SYSCON=y
CONFIG_REGMAP=y
CONFIG_REGMAP_MMIO=y
# CONFIG_CPU_FREQ is not set
# CONFIG_ZTE_ZX279133_CPUFREQ_PROBE is not set
# CONFIG_REGULATOR is not set
# CONFIG_PWM is not set
# CONFIG_PWM_ZX279133 is not set
# CONFIG_ZTE_ZX279133_PWM_AUDIT is not set

CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_ZX279133_WATCHDOG=y
CONFIG_WATCHDOG_NOWAYOUT=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=5

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEBUG_FS=y
CONFIG_SYSCTL=y

# CMA / contiguous DMA: the NPPT/IDM driver needs a 7.4 MB coherent DMA area
# (dmam_alloc_coherent 0x710000).  Without CMA this fails with -ENOMEM and the
# WAN driver never probes.  16 MB pool matches the known-good build.
CONFIG_MEMORY_ISOLATION=y
CONFIG_MIGRATION=y
CONFIG_CONTIG_ALLOC=y
CONFIG_CMA=y
CONFIG_CMA_AREAS=8
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=16
CONFIG_CMA_SIZE_SEL_MBYTES=y
CONFIG_CMA_ALIGNMENT=8

CONFIG_MAGIC_SYSRQ=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=-1
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=10
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y

CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_ZX279133=y
CONFIG_PINCTRL=y
CONFIG_PINMUX=y
CONFIG_GENERIC_PINCONF=y
CONFIG_PINCTRL_ZX279133=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y

CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_HWMON=y
CONFIG_SENSORS_ZX279133_PVT=y
CONFIG_NVMEM=y
CONFIG_NVMEM_LAYOUTS=y
CONFIG_NVMEM_ZX279133_EFUSE=y
# CONFIG_NVMEM_SYSFS is not set

CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MTD=y
# CONFIG_MTD_BLOCK is not set
CONFIG_MTD_OF_PARTS=y
# CONFIG_MTD_PARTITIONED_MASTER is not set
CONFIG_MTD_SPI_NAND=y
CONFIG_SPI=y
CONFIG_SPI_MEM=y
CONFIG_SPI_ZX279133_SFC=y

CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# CONFIG_MODULES is not set
# CONFIG_BLOCK_LEGACY_AUTOLOAD is not set

# ---- ZXDBG: WAN datapath under test ----------------------------------------
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_ZTE=y
CONFIG_ZTE_ZX279133_ETH=y
CONFIG_PHYLIB=y
CONFIG_PHYLINK=y
CONFIG_PCS_XPCS=y
CONFIG_ZX279051_PHY=y
CONFIG_MDIO_DEVICE=y
CONFIG_MDIO_BUS=y
CONFIG_MDIO_ZX279133=y
# CONFIG_MDIO_SR1010_RTL8372N_AUDIT is not set
# CONFIG_MDIO_SR1010_ZX279051_AUDIT is not set
# CONFIG_ZTE_ZX279133_XPCS_NPPT_AUDIT is not set

# devmem for direct IDM register inspection
CONFIG_DEVMEM=y
