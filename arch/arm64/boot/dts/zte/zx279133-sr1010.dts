/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "zx279133.dtsi"

/ {
	model = "ZTE ZXSLC SR1010";
	compatible = "zte,zx279133-sr1010", "zte,zx279133";

	aliases {
		serial0 = &uart0;
		watchdog0 = &watchdog0;
		watchdog1 = &watchdog1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		label = "SR1010 reset button";

		button-reset {
			debounce-interval = <50>;
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			label = "reset";
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led-white {
			color = <LED_COLOR_ID_WHITE>;
			default-state = "keep";
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio2 0 GPIO_ACTIVE_LOW>;
			label = "sr1010:white";
			retain-state-shutdown;
		};

		led-red {
			color = <LED_COLOR_ID_RED>;
			default-state = "keep";
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio2 4 GPIO_ACTIVE_LOW>;
			label = "sr1010:red";
			retain-state-shutdown;
		};
	};

	thermal-zones {
		soc-thermal {
			thermal-sensors = <&pvt>;
		};
	};
};

&uart0 {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&pvt {
	status = "okay";
};

&watchdog1 {
	status = "okay";
};

&spifc {
	/* Keep SFC timing conservative until it is characterized on hardware. */
	spi-max-frequency = <25000000>;
	status = "okay";

	flash@0 {
		read-only;
		spi-max-frequency = <25000000>;

		partitions {
			partition@100000 {
				read-only;
			};
		};
	};
};
